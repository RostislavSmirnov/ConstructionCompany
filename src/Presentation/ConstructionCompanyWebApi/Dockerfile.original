# Этап 1: сборка
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Копируем все csproj из решения
COPY ["src/Presentation/ConstructionCompanyWebApi/ConstructionCompanyWebApi.csproj", "src/Presentation/ConstructionCompanyWebApi/"]
COPY ["src/Core/Application/Application.csproj", "src/Core/Application/"]
COPY ["src/Core/Domain/Domain.csproj", "src/Core/Domain/"]
COPY ["src/Infrastructure/Persistence/Persistence.csproj", "src/Infrastructure/Persistence/"]

# Восстанавливаем зависимости
RUN dotnet restore "src/Presentation/ConstructionCompanyWebApi/ConstructionCompanyWebApi.csproj"

# Копируем весь код
COPY . .

# Собираем
WORKDIR "/src/src/Presentation/ConstructionCompanyWebApi"
RUN dotnet build "ConstructionCompanyWebApi.csproj" -c Release -o /app/build

# Публикация
FROM build AS publish
RUN dotnet publish "ConstructionCompanyWebApi.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Финальный образ
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "ConstructionCompanyWebApi.dll"]